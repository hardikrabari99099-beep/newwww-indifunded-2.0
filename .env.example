# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase configuration (optional — in-memory store & local auth active when unset)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Admin overrides (optional)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Razorpay payments (optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AI Gateway / Drizzle / Cron (optional)
LOVABLE_API_KEY=""
LOVABLE_DB_MIGRATION_URL=""
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""

# Business Gmail SMTP fallback (optional — can also be configured in Admin > Business Gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
